# Trailventure environment configuration (default = local development / test)
# For a real deployment: copy to .env and change the values below.

# --- API server ---
# Port the Express + SQLite API listens on.
PORT=3001
# Path to the SQLite database file.
DB_PATH=./server/data/trailventure.db

# --- Frontend ---
# Base URL of the API. LEAVE EMPTY in local development (Vite proxies /api and
# /uploads to the server automatically). For a hosted setup where the frontend
# and API live on different origins, set this to the deployed API URL, e.g.
#   VITE_API_BASE=https://api.trailventure.example.com
VITE_API_BASE=
