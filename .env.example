# Trailventure environment template
# Copy this file to `.env` and adjust the values for your deployment.
# Local development works out of the box with the defaults below.

# --- API server ---
# Port the Express + SQLite API listens on.
PORT=3001

# Path to the SQLite database file. Defaults to ./server/data/trailventure.db
# if unset. Point this anywhere writable for hosted environments.
DB_PATH=./server/data/trailventure.db

# --- Frontend ---
# Base URL of the API.
#   - Local dev: leave EMPTY. Vite proxies /api and /uploads to the server.
#   - Hosted:    set to the deployed API origin, e.g. https://api.example.com
VITE_API_BASE=

# --- Optional: swap the database backend ---
# The server uses SQLite via `better-sqlite3`. To plug in another database,
# replace the storage layer in server/db.js and keep this env-driven, e.g.
# DATABASE_URL=postgres://user:pass@host:5432/trailventure
